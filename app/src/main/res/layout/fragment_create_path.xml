<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorSurface">

    <!-- ── Toolbar fixe ────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="?attr/colorPrimary">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@android:color/white"
            android:contentDescription="Retour" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Créer un parcours"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_publish"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Publier"
            android:textSize="14sp"
            android:backgroundTint="@android:color/white"
            android:textColor="?attr/colorPrimary"
            app:cornerRadius="18dp" />

    </LinearLayout>

    <!-- ── Contenu défilable ───────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Photo de couverture (plein largeur, sans padding) ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_cover"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/cover_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#EEF0F4">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="@color/colorPrimary"
                        android:alpha="0.5"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Ajouter une photo de couverture"
                        android:textSize="14sp"
                        android:textColor="@color/colorPrimary"
                        android:alpha="0.7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Galerie ou appareil photo"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextHint" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/img_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_change_cover"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:text="Changer"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="@android:color/white"
                    android:visibility="gone"
                    app:cornerRadius="16dp"
                    app:strokeColor="@android:color/white"
                    app:backgroundTint="#66000000"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconSize="14dp" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── Contenu principal ────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="32dp">

            <!-- ─ Section : Informations ─ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="@color/colorPrimary"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Informations"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary" />

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Titre du parcours *"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="80"
                    android:imeOptions="actionNext" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Ville *"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:startIconDrawable="@android:drawable/ic_menu_mylocation"
                app:endIconMode="dropdown_menu">

                <AutoCompleteTextView
                    android:id="@+id/et_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:imeOptions="actionNext"
                    android:completionThreshold="2" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:hint="Description (optionnel)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:maxLines="5"
                    android:gravity="top" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorDivider"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <!-- ─ Section : Préférences ─ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="@color/colorPrimary"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Préférences"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary" />

            </LinearLayout>

            <!-- Durée -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Durée estimée"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary" />

                <TextView
                    android:id="@+id/tv_duree_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 h"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_duree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:valueFrom="1"
                android:valueTo="12"
                android:stepSize="1"
                android:value="3"
                app:trackColorActive="@color/colorPrimary"
                app:thumbColor="@color/colorPrimary"
                app:haloColor="@color/colorPrimaryLight" />

            <!-- Budget -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Budget maximum"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary" />

                <TextView
                    android:id="@+id/tv_budget_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80 €"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_budget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:valueFrom="0"
                android:valueTo="300"
                android:stepSize="10"
                android:value="80"
                app:trackColorActive="@color/colorPrimary"
                app:thumbColor="@color/colorPrimary"
                app:haloColor="@color/colorPrimaryLight" />

            <!-- Activités -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Types d'activités"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_activities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:singleSelection="false"
                app:selectionRequired="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_culture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Culture"
                    style="@style/ChipFilter.Traveling" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_restauration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Restauration"
                    style="@style/ChipFilter.Traveling" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_loisirs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loisirs"
                    style="@style/ChipFilter.Traveling" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_nature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nature"
                    style="@style/ChipFilter.Traveling" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_decouverte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Découverte"
                    style="@style/ChipFilter.Traveling" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Difficulté -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Difficulté"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_difficulty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:singleSelection="true"
                app:selectionRequired="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_easy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Facile"
                    style="@style/ChipFilter.Traveling" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_moderate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modéré"
                    style="@style/ChipFilter.Traveling" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_hard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Difficile"
                    style="@style/ChipFilter.Traveling" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Sensibilités météo (chips) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sensibilités météo"
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_meteo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:singleSelection="false"
                app:selectionRequired="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_chaleur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sensible à la chaleur"
                    style="@style/ChipFilter.Traveling" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_pluie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sensible à la pluie"
                    style="@style/ChipFilter.Traveling" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorDivider"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <!-- ─ Section : Génération automatique ─ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="@color/colorPrimary"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Génération automatique"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Générez un parcours optimisé selon vos préférences, la météo et les points d'intérêt locaux."
                android:textSize="13sp"
                android:textColor="@color/colorTextSecondary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="14dp" />

            <!-- Météo et résumé (affichés après génération) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_meteo_resume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F0F4FF"
                app:strokeColor="@color/colorPrimaryLight"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_meteo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary" />

                    <TextView
                        android:id="@+id/tv_resume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="13sp"
                        android:textColor="@color/colorTextSecondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_options_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choisissez un parcours"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/options_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_generate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Générer un parcours"
                android:textSize="15sp"
                android:textAllCaps="false"
                app:icon="@android:drawable/ic_menu_compass"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:cornerRadius="14dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorDivider"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <!-- ─ Section : Étapes ─ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="@color/colorPrimary"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Étapes du parcours"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_step"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Ajouter"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/steps_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="4dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorDivider"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp" />

            <!-- ─ Section : Paramètres ─ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_metric_row"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_share"
                    app:tint="@color/colorPrimary"
                    android:contentDescription="@null"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Parcours public"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visible par tous les utilisateurs"
                        android:textSize="12sp"
                        android:textColor="@color/colorTextSecondary" />

                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_public"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>

            <!-- Hidden CheckBoxes kept for Java compatibility -->
            <CheckBox
                android:id="@+id/cb_chaleur"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/cb_pluie"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    </ScrollView>

</LinearLayout>
