<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Zone image -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <ImageView
                android:id="@+id/sheet_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#FFE8EAED"
                android:contentDescription="@null" />

            <!-- Dégradé bas -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_hero_gradient" />

            <!-- Badge numéro étape -->
            <TextView
                android:id="@+id/sheet_step_number"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="14dp"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_step_circle" />

            <!-- Poignée de glissement -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_drag_handle"
                android:alpha="0.6" />

        </FrameLayout>

        <!-- Contenu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Nom de l'étape -->
            <TextView
                android:id="@+id/sheet_step_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <!-- Ligne métriques : prix + horaires -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_metric_row"
                android:padding="12dp"
                android:gravity="center_vertical">

                <!-- Prix -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/sheet_price_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:gravity="center"
                        android:text="—" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Prix"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorPrimary" />

                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="@color/colorDivider" />

                <!-- Horaires -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/sheet_hours_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"
                        android:gravity="center"
                        android:text="Chargement…"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Horaires"
                        android:textSize="10sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05"
                        android:textColor="@color/colorPrimary" />

                </LinearLayout>

            </LinearLayout>

            <!-- Séparateur -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorDivider"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp" />

            <!-- Label description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="12sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginBottom="6dp" />

            <!-- Texte description -->
            <TextView
                android:id="@+id/sheet_step_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/colorTextSecondary"
                android:visibility="gone" />

            <!-- Pas de description -->
            <TextView
                android:id="@+id/sheet_no_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aucune description disponible."
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="@color/colorTextHint"
                android:visibility="gone" />

            <!-- Bouton Maps -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_btn_maps"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="Voir sur la carte"
                android:textSize="14sp"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
