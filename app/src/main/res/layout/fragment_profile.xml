<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Avatar placeholder -->
    <ImageView
        android:id="@+id/profile_avatar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:contentDescription="Avatar"
        android:background="@android:drawable/dialog_holo_light_frame" />

    <TextView
        android:id="@+id/profile_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Mode anonyme"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/profile_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="Connectez-vous pour accéder à toutes les fonctionnalités"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:textAlignment="center" />

    <!-- Boutons connexion / inscription -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Se connecter"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_register"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="S'inscrire"
        android:textSize="16sp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <!-- Section paramètres (visible en mode connecté) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Paramètres"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_notifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Notifications"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        app:icon="@android:drawable/ic_popup_reminder"
        app:iconGravity="start" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_groups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mes groupes"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        app:icon="@android:drawable/ic_menu_myplaces"
        app:iconGravity="start" />

</LinearLayout>
