<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_explore">

    <fragment
        android:id="@+id/navigation_explore"
        android:name="com.example.traveling.ui.explore.ExploreFragment"
        android:label="Explorer"
        tools:layout="@layout/fragment_explore" />

    <fragment
        android:id="@+id/navigation_map"
        android:name="com.example.traveling.ui.map.MapFragment"
        android:label="Carte"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/navigation_create"
        android:name="com.example.traveling.ui.create.CreateFragment"
        android:label="Créer"
        tools:layout="@layout/fragment_create">
        <action
            android:id="@+id/action_create_to_share_photo"
            app:destination="@id/navigation_share_photo" />
        <action
            android:id="@+id/action_create_to_create_path"
            app:destination="@id/navigation_create_path" />
    </fragment>

    <fragment
        android:id="@+id/navigation_share_photo"
        android:name="com.example.traveling.ui.create.SharePhotoFragment"
        android:label="Partager une photo"
        tools:layout="@layout/fragment_share_photo" />

    <fragment
        android:id="@+id/navigation_create_path"
        android:name="com.example.traveling.ui.create.CreatePathFragment"
        android:label="Créer un parcours"
        tools:layout="@layout/fragment_create_path" />

    <fragment
        android:id="@+id/navigation_favorites"
        android:name="com.example.traveling.ui.favorites.FavoritesFragment"
        android:label="Favoris"
        tools:layout="@layout/fragment_favorites" />

    <fragment
        android:id="@+id/navigation_search_filter"
        android:name="com.example.traveling.ui.search.SearchFilterFragment"
        android:label="Filtres"
        tools:layout="@layout/fragment_search_filter" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.traveling.ui.profile.ProfileFragment"
        android:label="Profil"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_groups"
            app:destination="@id/navigation_groups" />
        <action
            android:id="@+id/action_profile_to_login"
            app:destination="@id/navigation_login" />
        <action
            android:id="@+id/action_profile_to_register"
            app:destination="@id/navigation_register" />
    </fragment>

    <fragment
        android:id="@+id/navigation_groups"
        android:name="com.example.traveling.ui.groups.GroupsFragment"
        android:label="Mes groupes"
        tools:layout="@layout/fragment_groups" />

    <fragment
        android:id="@+id/navigation_login"
        android:name="com.example.traveling.ui.auth.LoginFragment"
        android:label="Connexion"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/navigation_register" />
    </fragment>

    <fragment
        android:id="@+id/navigation_register"
        android:name="com.example.traveling.ui.auth.RegisterFragment"
        android:label="Inscription"
        tools:layout="@layout/fragment_register" />

</navigation>
